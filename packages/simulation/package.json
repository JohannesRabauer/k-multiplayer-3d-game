{
  "name": "@scooter-shooter/simulation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@scooter-shooter/game-config": "*"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
